      "code": {
        "path": "fs/exfat/util/exfat_upcase.c",
        "approved_at": "2026-04-30T21:18:26+00:00",
        "dirty": false
      },
      "invariants": [
        {
          "id": "exfat-upcase-no-write",
          "text": "不调用 los_part_write / los_disk_write。upcase 在 v1 mount 仅读盘。"
        },
        {
          "id": "exfat-upcase-checksum-verified",
          "text": "任何写入 sbi->vol_utbl 之前必须 chksum 校验通过。chksum mismatch 路径绝不 保留盘数据到 sbi。本 invariant 由 Step 10 强制：mismatch → goto err 释放 buf。"
        },
        {
          "id": "exfat-upcase-byte-order",
          "text": "upcase 表每 entry 是 LE16；本 v1 在 LE host 上 reinterpret cast 不动数据； 若未来端口到 BE host，本函数必须改为逐 entry `LE16_TO_HOST`。**当前实现 依赖 LE host 假设**——通过 `__LITEOS_A__` 宏保证（ARM-LE）。"
        },
        {
          "id": "exfat-upcase-free-idempotent",
          "text": "free_upcase_table 可重复调用、可对未加载 sbi 调用，结果一致：vol_utbl → NULL。"
        },
        {
          "id": "exfat-upcase-leak-free",
          "text": "失败路径下不留下任何已分配 heap。具体：buf 分配后若任意后续步骤失败必须 LOS_MemFree。"
        },
        {
          "id": "exfat-upcase-strict-no-fallback",
          "text": "v1 不退回内置默认 upcase 表。chksum mismatch / dentry 缺失 / IO 失败都直接 返回错误，导致 mount 失败。这与 Linux nls.c 在 chksum mismatch 时 fallback 不同；v1 选择此严格策略以避免引入 128KB 静态默认表的体积代价。"
        }
      ],
      "exports": [
        {
          "symbol": "exfat_create_upcase_table",
          "kind": "func"
        },
        {
          "symbol": "exfat_free_upcase_table",
          "kind": "func"
        }
      ]
