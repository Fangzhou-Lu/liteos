        "dirty": false
      },
      "invariants": [
        {
          "id": "exfat-balloc-load-leak-free",
          "text": "load_bitmap 失败路径下不留下任何已分配 heap。具体：vol_amap 在分配后若 IO 失败 必须 LOS_MemFree 并置 NULL。"
        },
        {
          "id": "exfat-balloc-free-idempotent",
          "text": "free_bitmap 可重复调用、可对未加载 sbi 调用，结果一致：vol_amap → NULL。"
        },
        {
          "id": "exfat-balloc-count-mem-only",
          "text": "count_used_clusters 不调 IO，不获取锁，不修改 vol_amap 内容。纯计算。"
        },
        {
          "id": "exfat-balloc-bitmap-size-policy",
          "text": "size 策略与 Linux 等价： - `need_map_size > map_size`：硬错（-EIO）； - `need_map_size < map_size`：PRINT_WARN，继续； - 等于：直接成功。 此策略允许格式化工具的 size padding 而拒绝结构上小到放不下的位图。"
        },
        {
          "id": "exfat-balloc-no-write",
          "text": "本层任何函数都不调用 los_part_write / los_disk_write。set_bitmap、clear_bitmap 留待 v2 写路径阶段实现。"
        },
        {
          "id": "exfat-balloc-bitmap-tail-mask",
          "text": "count_used_clusters 在最后一个字节用 `(1u << tail) - 1u` 掩码屏蔽超出 data_cluster_count 的位，避免计入 bitmap padding 的 set 位。"
        }
      ],
      "exports": [
        {
          "symbol": "exfat_load_bitmap",
          "kind": "func"
        },
        {
          "symbol": "exfat_free_bitmap",
          "kind": "func"
        },
        {
          "symbol": "exfat_count_used_clusters",
          "kind": "func"
