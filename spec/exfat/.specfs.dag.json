    {
      "id": "options",
      "stage_name": "options",
      "depends_on": [],
      "spec": {
        "path": "spec/exfat/util/exfat_options.spec",
        "approved_at": "2026-04-30T21:07:16+00:00",
        "dirty": false
      },
      "code": {
        "path": "fs/exfat/util/exfat_options.c",
        "approved_at": "2026-04-30T21:08:09+00:00",
        "dirty": false
      },
      "invariants": [
        {
          "id": "exfat-options-no-globals-no-io",
          "text": "解析过程不读写任何全局变量、不调用 IO 接口、不进行内存分配（iocharset 设为 静态字符串字面量地址，避免堆分配带来的释放责任问题）。"
        },
        {
          "id": "exfat-options-defaults-preserved",
          "text": "未在 `data` 中显式出现的 key，其对应字段在 opts 中保持**调用方写入的默认值 不变**。这是与 mount.spec Step 4 协作的硬约束——mount 已写好默认，parser 只覆盖显式项。"
        },
        {
          "id": "exfat-options-strict-key-rejection",
          "text": "未识别的 key 一律返回 `-EINVAL`，绝不\"宽容跳过\"。即使是 Linux 历史上的废弃项 （utf8/debug/namecase/codepage）也不静默接受——v1 简化兼容面。"
        },
        {
          "id": "exfat-options-no-heap-leak",
          "text": "失败路径上不留下任何已分配的堆内存。这意味着 v1 解析全程不调用 zalloc/LOS_MemAlloc—— iocharset 直接指向静态字符串 `\"utf8\"` 的地址（在 .rodata 段），由调用方在 sbi 释放时**不**调用 LOS_MemFree。"
        },
        {
          "id": "exfat-options-octal-mask-bit-width",
          "text": "所有 mask 字段（umask/fmask/dmask/allow_utime）按 9-bit 解析（最大 0777）。 解析器拒绝任何高位被置位的值。这与 POSIX 文件权限位一致。"
        }
      ],
      "exports": [
        {
          "symbol": "exfat_parse_options",
          "kind": "func"
        }
      ]
    },
    {
      "id": "dentry",
